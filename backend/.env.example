# ── Research Copilot — Backend Environment Template ──────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env to Git.
#
#   cp .env.example .env
#   nano .env   # fill in GEMINI_API_KEY
# ─────────────────────────────────────────────────────────────────────────────

# Required: your Google AI Studio / Vertex AI Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# ── Model routing ────────────────────────────────────────────────────────────
# Cheap, fast model for per-paper structured extraction
EXTRACTION_MODEL=gemini-2.5-flash-lite
# Smarter model for knowledge graph synthesis
SYNTHESIS_MODEL=gemini-2.5-flash

# ── Concurrency & pipeline tuning ────────────────────────────────────────────
ARXIV_CANDIDATE_COUNT=20
TOP_K_PAPERS=5
# Max simultaneous Gemini API calls (prevents RPM rate-limit hits)
GEMINI_CONCURRENCY=5

# ── Timeouts ─────────────────────────────────────────────────────────────────
# Max time (seconds) for the full search pipeline before returning 504
PIPELINE_TIMEOUT=120
# Max query length (chars); longer queries are silently truncated
MAX_QUERY_LENGTH=500

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_DIR=./cache
PAPER_TEXT_TTL_HOURS=168
EXTRACTION_TTL_HOURS=168
GRAPH_TTL_HOURS=72

# ── Authentication (optional) ────────────────────────────────────────────────
# Set to a secret string to require X-API-Key on all protected requests.
# Leave empty to disable auth (dev mode).
# API_AUTH_KEY=your-secret-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
